DJANGO_SECRET_KEY=
DATABASE_URL=

# Set to True for local development. Production cookies are HTTPS-only when this is False.
DJANGO_DEBUG=False

# Full origins allowed to send POST requests, comma separated.
# Example: https://bubbleflow.vercel.app,https://www.bubbleflow.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional legacy PostgreSQL configuration. DATABASE_URL takes precedence.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
